  "query": "\n        UPDATE users\n        SET name = COALESCE($2, name),\n            tag = COALESCE($3, tag),\n            profile_picture_url = COALESCE($4, profile_picture_url),\n            bio = COALESCE($5, bio)\n        WHERE user_id = $1\n        RETURNING user_id, name, tag, email, password, is_admin, profile_picture_url, bio\n        ",
